{
  "name": "@redstergs/family-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Independent Family UI design tokens and CSS components",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "test:browser": "playwright test"
  },
  "exports": {
    ".": "./src/index.css",
    "./tokens": "./src/tokens/index.css",
    "./components": "./src/components/index.css",
    "./dialogs": "./src/dialogs.ts",
    "./icons": "./src/icons.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "@playwright/test": "1.56.1"
  }
}
